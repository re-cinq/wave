# Local .env.experiment (gitignored). Sourced together with repo-root .env
# so CODEBERG_TOKEN_FULL and ANTHROPIC_TOKEN flow through.
WAVE_PROJECT_HOST=codeberg.org
WAVE_PROJECT_OWNER=libretech
WAVE_PROJECT_REPO=wave-testing
WAVE_PROJECT_TOKEN=${CODEBERG_TOKEN_FULL}

WAVE_ADAPTER=claude
WAVE_MODEL=balanced

# Standard env name claude-code expects.
ANTHROPIC_API_KEY=${ANTHROPIC_TOKEN}

# First smoke: skip onboard-project (zero LLM tokens). Unset to enable.
WAVE_SKIP_ONBOARD=1

WAVE_HOST_PORT=8080
